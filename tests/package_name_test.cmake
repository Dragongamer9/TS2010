# cmake -P tests/package_name_test.cmake : the version -> package-name mapping never collides.
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/TrainzPackageName.cmake")
function(expect version want)
  trainz_package_name_part("${version}" got)
  if(NOT got STREQUAL want)
    message(FATAL_ERROR "${version} -> '${got}', expected '${want}'")
  endif()
endfunction()
expect("0~ci" "0+tci")
expect("1~rc1" "1+trc1")
expect("1-rc1" "1+mrc1")
expect("1+rc1" "1+prc1")
expect("2:1.0" "2+c1.0")
expect("1.0A" "1.0+ua")
expect("1.0a" "1.0a")
# All of these must give different names.
set(seen "")
foreach(v 1~rc1 1-rc1 1+rc1 1.rc1 1rc1 1~RC1 1~rC1 1+mrc1 0~ci 0-ci)
  trainz_package_name_part("${v}" name)
  list(FIND seen "${name}" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "collision: ${v} -> ${name}")
  endif()
  list(APPEND seen "${name}")
endforeach()
message(STATUS "package name mapping: ok")
